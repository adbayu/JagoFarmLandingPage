# JagoFarm CMS Environment Configuration
# Copy this file to .env and configure your credentials.
# .env is ignored by Git and must never be committed.

CMS_ADMIN_EMAIL=your_email_here
CMS_ADMIN_PASSWORD=your_secure_password_here

# Supabase config (for CMS server and build-time data fetching)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase config for Vite (browser runtime - must have VITE_ prefix)
# These are exposed to the browser, so only use the anon key (never service role)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
