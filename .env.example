# JagoFarm CMS Environment Configuration
# Copy this file to .env and configure your credentials.
# .env is ignored by Git and must never be committed.

CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=change-this-secure-password

# Supabase config (for CMS server and build-time data fetching)
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-publishable-key-here
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# Supabase config for Vite (browser runtime - must have VITE_ prefix)
# These are exposed to the browser, so only use the anon key (never service role)
# Use the same values as above
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
